# Copy to .env and fill in. .env is gitignored; this file is not.
# Deployed values live in SSM under /btd/<env>/<kebab-name> (scripts/put_secrets.py).
# The cTrader client id/secret and tokens are not here: every run (local ones too, with your AWS
# credentials) reads the account's shared pair in SSM /platform/shared/ctrader-*. Never refresh it.

# cTrader account to trade: the shared Pepperstone DEMO account (dev refuses a live account)
CTRADER_ACCOUNT_ID=

# Telegram alerts and the evening summary
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AWS region for boto3, scripts and local terraform (default eu-west-1)
AWS_REGION=eu-west-1
